#!/usr/bin/env bash
#MISE description="Generate assets/css/chroma.css: token colours from Hugo's github and github-dark Chroma styles as light-dark() pairs"
#USAGE flag "--check" help="Do not write; fail if the committed file differs from what the pinned Hugo generates"
set -euo pipefail

cd "$MISE_PROJECT_ROOT"
out="assets/css/chroma.css"

# `hugo gen chromastyles` writes one rule per line:
#   /* Keyword */ .chroma .k { color:#cf222e }
# Both styles are generated and merged by selector into light-dark(light,
# dark) pairs. Only token classes (.chroma .k, .chroma .s1, ...) and their
# colour and background-colour are kept: the generator also emits the block
# surface, gutter layout, and (in github-dark) bold and italic weights, and
# those belong to the theme's stylesheet so highlighted and plain blocks
# match. A colour present in one style only gets currentColor (text) or
# transparent (background) on the other side.
#
# The output depends only on the pinned Hugo (its Chroma version), so rerun
# this after bumping the hugo pin in .mise.toml; --check shows whether the
# bump changed anything.
#
# shellcheck disable=SC2016  # the $0 below is awk's, not the shell's
merge='
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }

# Structural classes the theme styles itself.
BEGIN { skip["lntable"]; skip["lntd"]; skip["lnt"]; skip["ln"]; skip["line"]; skip["lnlinks"]; skip["hl"] }

function parse(line, side,    name, sel, cls, body, n, parts, i, kv, prop, val) {
  name = line; sub(/^\/\* */, "", name); sub(/ *\*\/.*$/, "", name)
  sel = line; sub(/^\/\*[^*]*\*\/ */, "", sel); sub(/ *\{.*$/, "", sel)
  if (sel !~ /^\.chroma \.[a-z0-9]+$/) return
  cls = sel; sub(/^\.chroma \./, "", cls)
  if (cls in skip) return
  body = line; sub(/^[^{]*\{ */, "", body); sub(/ *\}.*$/, "", body)
  n = split(body, parts, ";")
  for (i = 1; i <= n; i++) {
    kv = trim(parts[i]); if (kv == "") continue
    prop = kv; sub(/:.*$/, "", prop); prop = trim(prop)
    if (prop != "color" && prop != "background-color") continue
    val = kv; sub(/^[^:]*:/, "", val); val = trim(val)
    if (!(sel in seen)) { seen[sel] = 1; order[++count] = sel; names[sel] = name }
    if (!((sel, prop) in pseen)) { pseen[sel, prop] = 1; porder[sel, ++pcount[sel]] = prop }
    value[side, sel, prop] = val
    has[side, sel, prop] = 1
  }
}

function missing(prop) { return prop == "color" ? "currentColor" : "transparent" }

FNR == 1 { side++ }
/^\/\*.*\*\/ .*\{/ { parse($0, side) }

END {
  print "/* Generated by `mise run gen:chroma`; do not edit by hand."
  print "   Token colours of the Chroma styles github (light) and github-dark"
  print "   (dark) from `hugo gen chromastyles`, as light-dark() pairs. */"
  print ""
  for (c = 1; c <= count; c++) {
    sel = order[c]
    decls = ""
    for (p = 1; p <= pcount[sel]; p++) {
      prop = porder[sel, p]
      l = has[1, sel, prop] ? value[1, sel, prop] : missing(prop)
      d = has[2, sel, prop] ? value[2, sel, prop] : missing(prop)
      v = (l == d) ? l : "light-dark(" l ", " d ")"
      decls = decls prop ": " v "; "
    }
    sub(/ $/, "", decls)
    printf "/* %s */ %s { %s }\n", names[sel], sel, decls
  }
}
'

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
hugo gen chromastyles --style=github > "$tmp/light.css"
hugo gen chromastyles --style=github-dark > "$tmp/dark.css"
awk "$merge" "$tmp/light.css" "$tmp/dark.css" > "$tmp/chroma.css"

if [[ "${usage_check:-}" == "true" ]]; then
  if ! diff -u "$out" "$tmp/chroma.css"; then
    echo "FAIL: $out is out of date; run 'mise run gen:chroma'" >&2
    exit 1
  fi
  echo "$out is up to date"
else
  mv "$tmp/chroma.css" "$out"
  echo "Wrote $out"
fi
